[Desktop Entry]
Type=Application
Name=Media Sort
GenericName=Media Sorter
Comment=Sort and organize your photos, videos and audio collections
Exec=media-sort %U
Icon=${SNAP}/meta/gui/media-sort.svg
Terminal=false
Categories=Graphics;Photography;
MimeType=inode/directory;
Keywords=media;photo;video;audio;image;sort;organize;exif;
StartupNotify=true
StartupWMClass=MediaSort
